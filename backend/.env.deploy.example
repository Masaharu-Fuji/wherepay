# 本番（Fly.io）の環境変数の見本です。
# 秘密以外は backend/fly.toml の [env] に書いてあります。
# APP_KEY は fly.toml に書かず、backend/ で次を実行します。
#   php artisan key:generate --show
#   fly secrets set 'APP_KEY=base64:ここに表示された値'
# 値は見本です。秘密を書いたコピーはコミットしないでください。
# 手順の全文はリポジトリ直下 README の「デプロイ」です。

APP_NAME=wherepay
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:ReplaceWithOutputOfPhpArtisanKeyGenerateShow
APP_URL=https://wherepay-old-shape-6823.fly.dev

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ルームの保存先です。Fly Volume wherepay_data を /data にマウントします。
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

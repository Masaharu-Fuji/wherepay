# デプロイ時の環境変数の見本です。
# Render の Blueprint（リポジトリ直下の render.yaml）を使うと、印のない項目は自動で入ります。
# 自分でサービスを作るとき、または DATABASE_URL を差し替えるときに、このファイルを見本にしてください。
# 値は見本です。秘密を書いたコピーはコミットしないでください。

# --- アプリ ---

APP_NAME=wherepay
APP_ENV=production
APP_DEBUG=false

# クッキーの暗号化に使う 32 バイトの鍵です。
# 形は `base64:` のあとに、その鍵を base64 した文字列です。
# 手元で作るときは `php artisan key:generate --show` の出力をそのまま入れます。
# `base64:` が無い値は、起動時に付けます。
# Render の generateValue を使うときは、この行は空のままでも入ります。
APP_KEY=base64:ReplaceWithOutputOfPhpArtisanKeyGenerateShow

# 公開 URL です。https のときは、画面が生成するリンクも https になります。
# 空で RENDER_EXTERNAL_URL があるときは、そちらを使います。
APP_URL=https://wherepay.onrender.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- データベース ---

# ルームの保存先です。無料の Web はディスクを持たないので、Postgres を使います。
DB_CONNECTION=pgsql

# Postgres の接続文字列です。
# Render の Blueprint は wherepay-db の内部接続文字列をここに入れます。
# 30 日を超えて残すときは、この 1 行を Neon などの接続文字列に差し替えます。
DATABASE_URL=postgres://wherepay:password@dpg-example:5432/wherepay

# URL に sslmode が無いときの指定です。URL 側に sslmode があるときは、そちらが優先されます。
DB_SSLMODE=prefer

# --- 追加のサービスを使わずに動かす指定 ---

# セッション用のテーブルは作りません。
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true

# キャッシュ用のテーブルは作りません。ファイルはインスタンスが止まると消えます。
CACHE_STORE=file

# ワーカーは起動しません。
QUEUE_CONNECTION=sync

# --- ホストが起動時に渡すもの。見本では設定しません ---

# 待ち受けポートです。Render が渡します。未設定のときは 8080 です。
# PORT=10000

# Render の公開 URL です。APP_URL が空のときの代わりです。
# RENDER_EXTERNAL_URL=https://wherepay.onrender.com

# --- 任意。イメージの既定と同じなので、通常は書きません ---

# PHP_PM_MAX_CHILDREN=2
# PHP_PM_START_SERVERS=1
# PHP_MIN_SPARE_SERVERS=1
# PHP_MAX_SPARE_SERVERS=1
# PHP_MEMORY_LIMIT=128M

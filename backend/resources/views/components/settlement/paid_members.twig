{% if (paidMembers|length) > 0 %}
    <section class="ui-card">
        <div class="mb-3 flex items-center gap-2">
            <h3 class="ui-section-title">
                <span
                    class="icon-[lucide--circle-check] inline-block h-5 w-5 text-sub-green-ink"
                >

                </span>
                支払える人
            </h3>
            <span class="ui-count ml-auto">{{ paidMembers|length }}人</span>
        </div>
        <p class="mb-3 text-sm text-gray-500">
            所持金が、払う金額以上になっている人です。
        </p>
        <div class="flex flex-wrap gap-2">
            {% for member in paidMembers %}
                <span class="ui-chip">{{ member.member_name }}</span>
            {% endfor %}
        </div>
    </section>
{% endif %}

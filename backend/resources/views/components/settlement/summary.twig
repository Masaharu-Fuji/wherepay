<section class="ui-card">
    <p class="text-sm text-gray-500">合計金額</p>
    <p class="ui-money mt-1 text-3xl">
        ¥{{ total|number_format(0, '.', ',') }}
    </p>
    <ul class="mt-4 divide-y divide-gray-100 border-t border-gray-100">
        {% for member in room.members %}
            {% set debt = memberDebts[member.id]|default(0)|round(0, 'common') %}
            <li class="flex items-center justify-between gap-3 py-2.5">
                <span class="text-sm text-gray-900">
                    {{ member.member_name }}
                </span>
                <span class="text-sm text-gray-500">
                    負担額
                    <span class="ui-money">
                        ¥{{ debt|number_format(0, '.', ',') }}
                    </span>
                </span>
            </li>
        {% endfor %}
    </ul>
</section>

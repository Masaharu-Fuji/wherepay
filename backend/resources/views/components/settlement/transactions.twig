<div
    {% if (transactions|length) > 0 %}
        data-settlement-handoff
        data-room-name="{{ room.room_name|e('html_attr') }}"
    {% endif %}
>
    {% if (transactions|length) == 0 %}
        <p class="py-8 text-center text-sm text-gray-500">
            清算は完了しています
        </p>
    {% else %}
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <label class="block text-sm text-gray-600">
                この人の分だけ
                <select data-handoff-person class="ui-input mt-1.5 sm:w-56">
                    <option value="">全員</option>
                    {% for member in room.members %}
                        <option value="{{ member.id }}">
                            {{ member.member_name }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            <button type="button" data-handoff-copy class="ui-btn ui-btn-secondary">
                清算文をコピー
            </button>
        </div>
        <p data-handoff-empty class="mb-3 hidden text-sm text-gray-500">
            この人のやり取りはありません
        </p>
        <div class="divide-y divide-gray-100">
            {% for transaction in transactions %}
                {% set fromMember = membersById[transaction.from] ?? null %}
                {% set toMember = membersById[transaction.to] ?? null %}
                {% set fromName = fromMember ? fromMember.member_name : '不明' %}
                {% set toName = toMember ? toMember.member_name : '不明' %}
                <article
                    data-handoff-row
                    data-from="{{ transaction.from }}"
                    data-to="{{ transaction.to }}"
                    data-amount="{{ transaction.amount }}"
                    data-from-name="{{ fromName|e('html_attr') }}"
                    data-to-name="{{ toName|e('html_attr') }}"
                    class="py-3"
                >
                    <p class="text-base text-gray-900">
                        <span class="font-medium">{{ fromName }}</span>さん →
                        <span class="font-medium">{{ toName }}</span>さんに
                        <span class="ui-money">
                            ¥{{ transaction.amount|number_format(0, '.', ',') }}
                        </span>
                    </p>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>

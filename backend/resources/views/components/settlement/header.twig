<header class="ui-bar">
    <div class="ui-bar-inner">
        <a
            href="{{
            route(
                'rooms.show',
                {
                    room: room.id,
                    query_key: query_key,
                },
            )
            }}"
            class="ui-btn ui-btn-secondary"
        >
            戻る
        </a>
        <h1 class="text-lg font-semibold text-gray-900">清算結果</h1>
        <div class="flex flex-wrap items-center gap-2 sm:ml-auto">
            <a
                href="{{
                route(
                    'rooms.settlement.csv',
                    {
                        room: room.id,
                        query_key: query_key,
                    },
                )
                }}"
                class="ui-btn ui-btn-secondary"
            >
                清算結果CSV出力
            </a>
            {% if (transactions|length) > 0 %}
                <form
                    method="POST"
                    action="{{
                    route(
                        'rooms.settlement.confirm',
                        {
                            room: room.id,
                        },
                    )
                    }}"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token() }}"
                    />
                    <button
                        type="button"
                        data-settlement-confirm
                        data-is-fully-settled="{{ isFullySettled ? '1' : '0' }}"
                        data-has-paid-members="{{ (paidMembers|length) > 0 ? '1' : '0' }}"
                        class="ui-btn ui-btn-primary"
                    >
                        清算を確定して保存
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</header>

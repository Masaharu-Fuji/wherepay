{% if (locatedItems|length) == 0 %}
    <p class="text-sm text-gray-500">位置情報のある品目はまだありません。</p>
{% else %}
    <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="ui-count">{{ locatedItems|length }}ヶ所</span>
        {% if allLocationsUrl %}
            <a
                href="{{ allLocationsUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                class="ui-btn ui-btn-secondary ml-auto"
            >
                経路表示
            </a>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in locatedItems %}
            {% set payer = item.payer %}
            <article class="flex h-full flex-col gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
                <div class="flex items-start gap-2">
                    <span
                        class="{{
                        cn(
                            'flex h-6 w-6 shrink-0 items-center justify-center',
                            'rounded-full bg-gray-200 text-xs font-medium text-gray-700',
                        )
                        }}"
                    >
                        {{ loop.index }}
                    </span>
                    <h4 class="min-w-0 flex-1 text-sm font-medium text-gray-900">
                        {{ item.item_name }}
                    </h4>
                    {% if
                        item.location
                            and item.location.latitude is not null
                            and item.location.longitude is not null %}
                        {% set mapUrl = 'https://www.google.com/maps/search/?api=1&query='
                            ~ item.location.latitude
                            ~ ','
                            ~ item.location.longitude
                        %}
                        <a
                            href="{{ mapUrl }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="ui-btn ui-btn-secondary shrink-0 px-2.5 py-1.5"
                        >
                            地図
                        </a>
                    {% endif %}
                </div>
                <p class="text-sm">
                    <span class="ui-money">
                        ¥{{ item.amount|number_format(0, '.', ',') }}
                    </span>
                    <span class="text-gray-600">
                        {{ payer ? payer.member_name : '不明' }}
                    </span>
                </p>
                <p class="text-xs text-gray-400">
                    {{ item.location.latitude }}, {{ item.location.longitude }}
                </p>
            </article>
        {% endfor %}
    </div>
{% endif %}

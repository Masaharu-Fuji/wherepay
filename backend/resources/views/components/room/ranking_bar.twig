{% if (ranking|length) > 0 %}
    <div
        id="ranking-bar"
        class="{{
        cn(
            'ranking-bar is-collapsed fixed bottom-0 left-0 right-0 z-20',
            'border-t border-gray-200 bg-white shadow-lg',
            'transition-transform duration-300 ease-out',
        )
        }}"
    >
        <div class="mx-auto max-w-5xl px-4">
            <button
                id="ranking-bar-toggle"
                type="button"
                class="flex h-14 w-full items-center justify-between gap-3 text-left"
            >
                <span class="ui-section-title">
                    <span class="icon-[lucide--trophy] ui-icon"></span>
                    支払いランキング
                </span>
                <span
                    class="text-sm text-gray-500"
                    data-open-text="閉じる"
                    data-closed-text="開く"
                >
                    開く
                </span>
            </button>
            <div id="ranking-bar-content" class="space-y-2 pb-4">
                {% for entry in ranking %}
                    {% set index = loop.index0 %}
                    {% set medalColors = [
                        'bg-sub-yellow text-gray-900',
                        'bg-gray-200 text-gray-700',
                        'bg-amber-800 text-white',
                    ] %}
                    {% set defaultColor = 'bg-gray-100 text-gray-600' %}
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-3">
                            <div
                                class="{{
                                cn(
                                    'flex h-7 w-7 items-center justify-center',
                                    'rounded-full text-sm font-semibold',
                                    medalColors[index] ?? defaultColor,
                                )
                                }}"
                            >
                                {{ loop.index }}
                            </div>
                            <span class="truncate text-sm text-gray-900">
                                {{ entry.member.member_name }}
                            </span>
                        </div>
                        <span class="ui-money text-base">
                            ¥{{ entry.total|number_format(0, '.', ',') }}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}

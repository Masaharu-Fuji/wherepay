<div class="ui-card">
    <h3 class="ui-section-title mb-4">
        <span class="icon-[lucide--plus] ui-icon"></span>
        品目追加
    </h3>
    <form
        method="POST"
        action="{{
        route(
            'rooms.items.store',
            {
                room: room.id,
            },
        )
        }}"
        class="space-y-4"
        id="item-form"
        data-item-form
        data-room-id="{{ room.id }}"
    >
        <input type="hidden" name="_token" value="{{ csrf_token() }}" />
        <input type="hidden" name="latitude" id="latitude" />
        <input type="hidden" name="longitude" id="longitude" />
        <input type="hidden" name="location_address" id="location_address" />

        <div>
            <label for="item_name" class="ui-label">品目名</label>
            <input
                id="item_name"
                name="item_name"
                placeholder="例: ランチ代、タクシー代"
                value="{{ old('item_name') }}"
                class="ui-input"
                required
            />
            {% if errors.has('item_name') %}
                <p class="mt-1.5 text-sm text-danger">
                    {{ errors.first('item_name') }}
                </p>
            {% endif %}
        </div>

        <div>
            <label for="amount" class="ui-label">金額（円）</label>
            <input
                id="amount"
                name="amount"
                type="number"
                min="1"
                value="{{ old('amount') }}"
                class="ui-input"
                required
            />
            {% if errors.has('amount') %}
                <p class="mt-1.5 text-sm text-danger">
                    {{ errors.first('amount') }}
                </p>
            {% endif %}
        </div>

        <div>
            <label for="payer_id" class="ui-label">支払者（誰が支払ったか）</label>
            <select id="payer_id" name="payer_id" class="ui-input" required>
                <option value="">選択してください</option>
                {% for member in room.members %}
                    <option
                        value="{{ member.id }}"
                        {{ old('payer_id') == member.id ? 'selected' : '' }}
                    >
                        {{ member.member_name }}
                    </option>
                {% endfor %}
            </select>
            {% if errors.has('payer_id') %}
                <p class="mt-1.5 text-sm text-danger">
                    {{ errors.first('payer_id') }}
                </p>
            {% endif %}
        </div>

        <div
            data-participant-jump-root
            data-participant-editor
            data-amount-input="amount"
            data-payer-select="payer_id"
        >
            <p class="ui-label">対象者（誰の分の支払いか）</p>
            {% if (room.members|length) > 0 %}
                <div class="mb-2 flex flex-wrap gap-2">
                    <button type="button" data-participant-all class="ui-btn ui-btn-secondary">
                        全員
                    </button>
                    <button
                        type="button"
                        data-participant-except-payer
                        class="ui-btn ui-btn-secondary"
                    >
                        支払者以外
                    </button>
                    <button type="button" data-participant-clear class="ui-btn ui-btn-secondary">
                        クリア
                    </button>
                </div>
                <div class="mb-2 flex items-stretch gap-2">
                    <label class="sr-only" for="participant-jump-new-item">
                        対象者名でジャンプ
                    </label>
                    <input
                        id="participant-jump-new-item"
                        type="search"
                        enterkeyhint="go"
                        inputmode="search"
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"
                        placeholder="名前の一部で移動"
                        data-participant-jump-input
                        class="ui-input"
                    />
                    <button
                        type="button"
                        data-participant-jump-go
                        aria-label="名前の一致へスクロール"
                        class="ui-btn ui-btn-secondary shrink-0"
                    >
                        移動
                    </button>
                </div>
            {% endif %}
            <div
                data-participant-jump-scroll
                class="ui-scroll max-h-[min(55svh,18rem)] md:max-h-48"
            >
                {% if (room.members|length) == 0 %}
                    <p class="px-1 py-2 text-sm text-gray-500">
                        先にメンバーを追加してください
                    </p>
                {% else %}
                    {% for member in room.members %}
                        <label
                            data-participant-jump-row
                            data-member-name="{{ member.member_name|e('html_attr') }}"
                            class="ui-choice"
                        >
                            <input
                                type="checkbox"
                                name="participant_ids[]"
                                value="{{ member.id }}"
                                {{ (member.id ~ '') in (
                                    errors.getBag('default').isNotEmpty()
                                        ? old('participant_ids', [])
                                        : []
                                ) ? 'checked' : '' }}
                                class="ui-check"
                            />
                            <span class="text-sm text-gray-900">
                                {{ member.member_name }}
                            </span>
                        </label>
                    {% endfor %}
                {% endif %}
            </div>
            {% if errors.has('participant_ids') %}
                <p class="mt-1.5 text-sm text-danger">
                    {{ errors.first('participant_ids') }}
                </p>
            {% endif %}
            <p data-per-person class="mt-2 text-sm text-gray-500">
                対象者を選ぶと、1人あたりの金額が出ます
            </p>
        </div>

        <div class="flex flex-col gap-2">
            <button
                type="button"
                onclick="fetchItemGeoLocation()"
                class="ui-btn ui-btn-secondary w-full"
            >
                <span class="icon-[lucide--map-pin] h-4 w-4"></span>
                位置情報を付ける（任意）
            </button>
            <button type="submit" class="ui-btn ui-btn-primary w-full">
                追加
            </button>
        </div>
    </form>
</div>

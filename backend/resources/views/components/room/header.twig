<header class="ui-bar">
    <div class="ui-bar-inner">
        <div class="min-w-0 flex-1 basis-full sm:basis-auto">
            <h1 class="truncate text-lg font-semibold text-gray-900">
                {{ room.room_name }}
            </h1>
            <p class="text-sm text-gray-500">
                合計
                <span class="ui-money">
                    ¥{{ totalAmount|number_format(0, '.', ',') }}
                </span>
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ route('rooms.create') }}" class="ui-btn ui-btn-secondary">
                ルーム選択に戻る
            </a>
            <input
                id="room-url"
                type="text"
                readonly
                tabindex="-1"
                aria-hidden="true"
                class="sr-only"
                value="{{
                route(
                    'rooms.show',
                    {
                        room: room.id,
                        query_key: room.password_plan,
                    },
                )
                }}"
            />
            <button type="button" id="copy-room-url" class="ui-btn ui-btn-secondary">
                URLをコピー
            </button>
            <a
                href="{{
                route(
                    'rooms.csv',
                    {
                        room: room.id,
                        query_key: room.password_plan,
                    },
                )
                }}"
                class="ui-btn ui-btn-secondary"
            >
                品目一覧CSV出力
            </a>
        </div>
    </div>
</header>

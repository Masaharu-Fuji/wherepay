<div class="ui-card">
    <div class="mb-4 flex items-center gap-2">
        <h3 class="ui-section-title">
            <span class="icon-[lucide--receipt] ui-icon"></span>
            品目一覧
        </h3>
        <span class="ui-count">{{ room.items|length }}件</span>
        <a
            href="{{
            route(
                'rooms.items.index',
                {
                    room: room.id,
                    query_key: room.password_plan,
                },
            )
            }}"
            class="ui-btn ui-btn-secondary ml-auto"
        >
            編集
        </a>
    </div>

    {% if (room.items|length) == 0 %}
        <p class="py-10 text-center text-sm text-gray-500">
            品目を追加してください
        </p>
    {% else %}
        <div id="room-items-scroll" class="space-y-3 md:overflow-y-auto">
            {% for item in room.items %}
                {% set payer = item.payer %}
                {% set recipients = [] %}
                {% set selectedParticipantIds = [] %}
                {% for participant in item.participants %}
                    {% if participant.member %}
                        {% set recipients =
                            recipients|merge([participant.member.member_name])
                        %}
                    {% endif %}
                    {% set selectedParticipantIds =
                        selectedParticipantIds|merge([participant.member_id])
                    %}
                {% endfor %}
                <article class="rounded-lg border border-gray-200 bg-gray-50 p-3 md:p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h4 class="font-medium text-gray-900">
                                {{ item.item_name }}
                            </h4>
                            <p class="mt-1 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-sm text-gray-600">
                                <span class="font-medium text-gray-900">
                                    {{ payer ? payer.member_name : '不明' }}
                                </span>
                                {% if (recipients|length) > 0 %}
                                    <span
                                        class="icon-[lucide--arrow-right] inline-block h-3.5 w-3.5 text-gray-400"
                                    ></span>
                                    <span>{{ recipients|join('、') }}</span>
                                {% endif %}
                            </p>
                            {% if item.location %}
                                <p class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-sub-green-ink">
                                    <span class="icon-[lucide--map-pin] inline-block h-3.5 w-3.5"></span>
                                    位置情報あり
                                </p>
                            {% endif %}
                        </div>
                        <div class="shrink-0 text-right">
                            <p class="ui-money text-lg">
                                ¥{{ item.amount|number_format(0, '.', ',') }}
                            </p>
                            {% if (item.participants|length) > 0 %}
                                {% set per_person =
                                    (item.amount / (item.participants|length))
                                        |round(0, 'common')
                                        |number_format(0, '.', ',')
                                %}
                                <p class="text-xs text-gray-500">
                                    1人 ¥{{ per_person }}
                                </p>
                            {% endif %}
                            {% if item.created_at %}
                                <p class="mt-1 text-xs text-gray-400">
                                    {{
                                        item.created_at|date(
                                            'Y/m/d H:i',
                                            'Asia/Tokyo',
                                        )
                                    }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    {% set participantErrors =
                        errors.getBag('itemParticipants' ~ item.id)
                    %}
                    {% set checkedParticipantIds =
                        participantErrors.isNotEmpty()
                            ? old('participant_ids', [])
                            : selectedParticipantIds
                    %}
                    <details
                        class="mt-3 border-t border-gray-200 pt-3"
                        {{ participantErrors.isNotEmpty() ? 'open' : '' }}
                    >
                        <summary class="cursor-pointer text-sm font-medium text-gray-700">
                            対象者を直す
                        </summary>
                        <form
                            method="POST"
                            action="{{
                            route(
                                'rooms.items.participants.update',
                                {
                                    room: room.id,
                                    item: item.id,
                                    query_key: room.password_plan,
                                },
                            )
                            }}"
                            class="mt-3 space-y-3"
                            data-participant-editor
                            data-amount="{{ item.amount }}"
                            data-payer-id="{{ item.payer_id }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token() }}"
                            />
                            <input type="hidden" name="_method" value="PATCH" />
                            <div class="flex flex-wrap gap-2">
                                <button
                                    type="button"
                                    data-participant-all
                                    class="ui-btn ui-btn-secondary"
                                >
                                    全員
                                </button>
                                <button
                                    type="button"
                                    data-participant-except-payer
                                    class="ui-btn ui-btn-secondary"
                                >
                                    支払者以外
                                </button>
                                <button
                                    type="button"
                                    data-participant-clear
                                    class="ui-btn ui-btn-secondary"
                                >
                                    クリア
                                </button>
                            </div>
                            <div class="ui-scroll max-h-48 bg-white">
                                {% for member in room.members %}
                                    <label class="ui-choice">
                                        <input
                                            type="checkbox"
                                            name="participant_ids[]"
                                            value="{{ member.id }}"
                                            {{ (',' ~ member.id ~ ',') in (
                                                ','
                                                    ~ checkedParticipantIds|join(',')
                                                    ~ ','
                                            )
                                                ? 'checked'
                                                : '' }}
                                            class="ui-check"
                                        />
                                        <span class="text-sm text-gray-900">
                                            {{ member.member_name }}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                            {% if participantErrors.isNotEmpty() %}
                                <p role="alert" class="text-sm text-danger">
                                    {{ participantErrors.first }}
                                </p>
                            {% endif %}
                            <p data-per-person class="text-sm text-gray-500">
                                対象者を選ぶと、1人あたりの金額が出ます
                            </p>
                            <button type="submit" class="ui-btn ui-btn-primary">
                                この内容で直す
                            </button>
                        </form>
                    </details>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>

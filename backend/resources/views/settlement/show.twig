{% extends 'layouts.base' %}

{% block title %}
    清算結果 - 清算アプリ
{% endblock %}

{% block content %}
    <div class="min-h-screen">
        {{
            include(
                'components.settlement.header',
                {
                    room: room,
                    query_key: query_key,
                    isFullySettled: isFullySettled,
                },
            )
        }}

        <div class="ui-page space-y-4">
            {% if isFullySettled %}
                {{ include('components.settlement.completed') }}
            {% endif %}

            {{ include('components.settlement.summary') }}

            {{ include('components.settlement.items') }}

            {{ include('components.settlement.paid_members') }}

            <div class="space-y-3" data-accordion>
                <section class="ui-card overflow-hidden p-0">
                    <button
                        type="button"
                        class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left md:px-5"
                        data-accordion-button
                        data-accordion-target="payments"
                        aria-expanded="true"
                    >
                        <span class="ui-section-title">
                            <span
                                class="icon-[lucide--arrow-left-right] ui-icon"
                            >

                            </span>
                            支払い計算
                        </span>
                        <span
                            class="icon-[lucide--chevron-down] ui-icon rotate-180 transition-transform"
                            data-accordion-chevron
                        >

                        </span>
                    </button>
                    <div
                        class="border-t border-gray-100 px-4 py-4 md:px-5"
                        data-accordion-panel="payments"
                    >
                        {{ include('components.settlement.transactions') }}
                    </div>
                </section>

                <section class="ui-card overflow-hidden p-0">
                    <button
                        type="button"
                        class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left md:px-5"
                        data-accordion-button
                        data-accordion-target="change"
                        aria-expanded="false"
                    >
                        <span class="ui-section-title">
                            <span class="icon-[lucide--coins] ui-icon"></span>
                            おつり計算
                        </span>
                        <span
                            class="icon-[lucide--chevron-down] ui-icon transition-transform"
                            data-accordion-chevron
                        >

                        </span>
                    </button>
                    <div
                        class="hidden border-t border-gray-100 px-4 py-4 md:px-5"
                        data-accordion-panel="change"
                    >
                        {{ include('components.settlement.change_form') }}
                    </div>
                </section>

                <section class="ui-card overflow-hidden p-0">
                    <button
                        type="button"
                        class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left md:px-5"
                        data-accordion-button
                        data-accordion-target="locations"
                        aria-expanded="false"
                    >
                        <span class="ui-section-title">
                            <span class="icon-[lucide--map-pin] ui-icon"></span>
                            訪れた場所
                        </span>
                        <span
                            class="icon-[lucide--chevron-down] ui-icon transition-transform"
                            data-accordion-chevron
                        >

                        </span>
                    </button>
                    <div
                        class="hidden border-t border-gray-100 px-4 py-4 md:px-5"
                        data-accordion-panel="locations"
                    >
                        {{ include('components.settlement.locations') }}
                    </div>
                </section>
            </div>
        </div>
    </div>
{% endblock %}

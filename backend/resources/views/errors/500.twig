{% extends 'layouts/base.twig' %}

{% block title %}
    500 | サーバーエラー
{% endblock %}

{% block content %}
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="ui-card w-full max-w-md text-center">
            <p class="text-sm font-medium text-gray-500">500</p>
            <h1 class="mt-2 text-2xl font-semibold text-gray-900">
                サーバーで問題が発生しました
            </h1>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">
                しばらくしてから再度お試しください。
                問題が続く場合はお問い合わせください。
            </p>
            <a href="/" class="ui-btn ui-btn-primary mt-6">ホームに戻る</a>
        </div>
    </div>
{% endblock %}

{% extends 'layouts.base' %}

{% block title %}
    アクセスキー入力 - {{ room.room_name }} - 清算アプリ
{% endblock %}

{% block content %}
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="ui-card w-full max-w-md">
            <h1 class="text-center text-xl font-semibold text-gray-900">
                アクセスキー入力
            </h1>
            <p class="mt-2 text-center text-sm text-gray-600">
                ルーム「{{ room.room_name }}」は保護されています。
            </p>

            <form
                method="GET"
                action="{{
                route(
                    'rooms.show',
                    {
                        room: room.id,
                    },
                )
                }}"
                class="mt-6 space-y-4"
            >
                <div>
                    <label class="sr-only" for="query_key">アクセスキー</label>
                    <input
                        id="query_key"
                        name="query_key"
                        type="text"
                        placeholder="アクセスキーを入力してください"
                        class="ui-input"
                        autofocus
                        required
                    />
                </div>

                <button type="submit" class="ui-btn ui-btn-primary w-full">
                    ルームに入る
                </button>
            </form>

            <div class="mt-6 border-t border-gray-200 pt-4">
                <a
                    href="{{ route('rooms.create') }}"
                    class="block text-center text-sm text-gray-600 hover:text-gray-900"
                >
                    ルーム選択に戻る
                </a>
            </div>
        </div>
    </div>
{% endblock %}

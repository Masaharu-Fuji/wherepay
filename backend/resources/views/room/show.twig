{% extends 'layouts.base' %}

{% block title %}
    {{ room.room_name }} - 清算アプリ
{% endblock %}

{% block content %}
    <div class="pb-20">
        {{ include('components.room.header') }}

        {% if statusMessage %}
            <div class="mx-auto w-full max-w-5xl px-4 pt-4">
                <p role="status" class="ui-status">
                    {{ statusMessage }}
                </p>
            </div>
        {% endif %}

        <div
            class="{{
            cn(
                'ui-page grid gap-4 md:items-start md:gap-6',
                'md:grid-cols-[22rem_minmax(0,1fr)]',
                'lg:grid-cols-[28rem_minmax(0,1fr)]',
            )
            }}"
        >
            <div class="space-y-4">
                {{ include('components.room.members') }}
                {{ include('components.room.forms') }}
                {{ include('components.room.settlement_link') }}
            </div>
            <div>
                {{ include('components.room.items') }}
            </div>
        </div>

        {{ include('components.room.ranking_bar') }}
    </div>
{% endblock %}

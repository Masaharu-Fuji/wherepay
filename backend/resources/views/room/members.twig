{% extends 'layouts.base' %}

{% block title %}
    ユーザ一覧 - {{ room.room_name }}
{% endblock %}

{% block content %}
    <div class="ui-page space-y-4 pb-16">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h1 class="text-xl font-semibold text-gray-900">ユーザ一覧</h1>
                <p class="text-sm text-gray-500">
                    {{ room.room_name }}（{{ room.members|length }}人）
                </p>
            </div>
            <a
                href="{{
                route(
                    'rooms.show',
                    {
                        room: room.id,
                        query_key: room.password_plan,
                    },
                )
                }}"
                class="ui-btn ui-btn-secondary"
            >
                ルーム詳細へ戻る
            </a>
        </div>

        {% if errors.has('member_name') %}
            <p class="text-sm text-danger">{{ errors.first('member_name') }}</p>
        {% endif %}

        <div class="ui-card">
            {% if (room.members|length) == 0 %}
                <p class="text-sm text-gray-500">ユーザが登録されていません。</p>
            {% else %}
                <div class="space-y-3">
                    {% for member in room.members %}
                        <form
                            method="POST"
                            action="{{
                            route(
                                'rooms.members.update',
                                {
                                    room: room.id,
                                    member: member.id,
                                    query_key: room.password_plan,
                                },
                            )
                            }}"
                            class="grid grid-cols-1 items-center gap-2 md:grid-cols-[1fr_auto]"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token() }}"
                            />
                            <input type="hidden" name="_method" value="PATCH" />
                            <input
                                name="member_name"
                                value="{{ old('member_name', member.member_name) }}"
                                class="ui-input"
                                required
                            />
                            <button type="submit" class="ui-btn ui-btn-primary">
                                更新
                            </button>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% extends 'layouts.base' %}

{% block title %}
    ユーザ一覧 - {{ room.room_name }}
{% endblock %}

{% block content %}
    <div class="min-h-screen pb-16 flex justify-center items-center">
        <div
            class="{{
            cn(
                'max-w-4xl px-4 py-4 md:py-6',
                'flex flex-col gap-3 md:gap-4'
            )
            }}"
        >
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h1 class="text-xl md:text-2xl font-semibold">
                        ユーザ一覧
                    </h1>
                    <p class="text-sm text-gray-600">
                        {{ room.room_name }}（{{ room.members|length }}人）
                    </p>
                </div>
                <a
                    href="{{
                    route(
                        'rooms.show',
                        {
                            room: room.id,
                            query_key: room.password_plan
                        }
                    )
                    }}"
                    class="{{
                    cn(
                        'px-3 py-2 text-xs md:text-sm',
                        'bg-gray-100 hover:bg-gray-200 rounded-md transition-colors'
                    )
                    }}"
                >
                    ルーム詳細へ戻る
                </a>
            </div>

            {% if errors.has('member_name') %}
                <p class="text-sm text-sub-pink">
                    {{ errors.first('member_name') }}
                </p>
            {% endif %}

            <div
                class="bg-white rounded-2xl border border-gray-200 shadow-lg p-3 md:p-6"
            >
                {% if (room.members|length) == 0 %}
                    <p class="text-gray-500 text-sm">
                        ユーザが登録されていません。
                    </p>
                {% else %}
                    <div class="space-y-3">
                        {% for member in room.members %}
                            <form
                                method="POST"
                                action="{{
                                route(
                                    'rooms.members.update',
                                    {
                                        room: room.id,
                                        member: member.id,
                                        query_key: room.password_plan
                                    }
                                )
                                }}"
                                class="{{
                                cn(
                                    'grid grid-cols-1 md:grid-cols-[1fr_auto] gap-2',
                                    'items-center'
                                )
                                }}"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token() }}"
                                />
                                <input
                                    type="hidden"
                                    name="_method"
                                    value="PATCH"
                                />
                                <input
                                    name="member_name"
                                    value="{{
                                    old(
                                        'member_name',
                                        member.member_name
                                    )
                                    }}"
                                    class="{{
                                    cn(
                                        'w-full text-sm md:text-base p-2',
                                        'border-2 border-gray-200 rounded-xl',
                                        'focus:outline-none focus:border-primary',
                                        'focus:ring-4 focus:ring-primary-100',
                                        'transition-all'
                                    )
                                    }}"
                                    required
                                />
                                <button
                                    type="submit"
                                    class="{{
                                    cn(
                                        'px-4 py-2 text-sm md:text-base',
                                        'bg-linear-to-r from-primary to-sub-pink text-white',
                                        'rounded-xl hover:from-primary-hover hover:to-sub-pink-hover',
                                        'shadow-md transition-all'
                                    )
                                    }}"
                                >
                                    更新
                                </button>
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

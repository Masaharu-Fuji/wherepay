{% extends 'layouts.base' %}

{% block title %}
    品目一覧 - {{ room.room_name }}
{% endblock %}

{% block content %}
    <div class="ui-page space-y-4 pb-16">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h1 class="text-xl font-semibold text-gray-900">品目編集</h1>
                <p class="text-sm text-gray-500">
                    {{ room.room_name }}（{{ room.items|length }}件）
                </p>
            </div>
            <a
                href="{{
                route(
                    'rooms.show',
                    {
                        room: room.id,
                        query_key: room.password_plan,
                    },
                )
                }}"
                class="ui-btn ui-btn-secondary"
            >
                ルーム詳細へ戻る
            </a>
        </div>

        {% if errors.has('item_name') %}
            <p class="text-sm text-danger">{{ errors.first('item_name') }}</p>
        {% endif %}
        {% if errors.has('participant_ids') %}
            <p class="text-sm text-danger">
                {{ errors.first('participant_ids') }}
            </p>
        {% endif %}
        {% if errors.has('latitude') %}
            <p class="text-sm text-danger">{{ errors.first('latitude') }}</p>
        {% endif %}
        {% if errors.has('longitude') %}
            <p class="text-sm text-danger">{{ errors.first('longitude') }}</p>
        {% endif %}

        <div class="ui-card">
            {% if (room.items|length) == 0 %}
                <p class="text-sm text-gray-500">品目が登録されていません。</p>
            {% else %}
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    {% for item in room.items %}
                        {% set selectedParticipantIds = [] %}
                        {% for participant in item.participants %}
                            {% set selectedParticipantIds =
                                selectedParticipantIds|merge(
                                    [participant.member_id],
                                )
                            %}
                        {% endfor %}
                        <form
                            method="POST"
                            action="{{
                            route(
                                'rooms.items.update',
                                {
                                    room: room.id,
                                    item: item.id,
                                    query_key: room.password_plan,
                                },
                            )
                            }}"
                            class="h-full space-y-3 rounded-lg border border-gray-200 bg-gray-50 p-3 md:p-4"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token() }}"
                            />

                            <div
                                class="{{
                                cn(
                                    'flex items-center gap-2 overflow-x-auto whitespace-nowrap',
                                    'rounded-lg border border-gray-200 bg-white',
                                    'px-2 py-1.5 text-xs md:hidden',
                                )
                                }}"
                            >
                                <span class="font-medium text-gray-900">
                                    {{ item.item_name }}
                                </span>
                                <span class="text-gray-300">/</span>
                                <span class="ui-money">
                                    ¥{{ item.amount|number_format(0, '.', ',') }}
                                </span>
                                <span class="text-gray-300">/</span>
                                <span class="text-gray-600">
                                    {{ item.payer
                                        ? item.payer.member_name
                                        : '不明' }}
                                </span>
                            </div>

                            <div class="hidden items-center gap-2 md:flex">
                                <label class="ui-label mb-0 shrink-0">品目</label>
                                <input
                                    name="item_name"
                                    value="{{ old('item_name', item.item_name) }}"
                                    class="ui-input"
                                    required
                                />
                            </div>

                            <div class="hidden gap-3 md:grid md:grid-cols-2">
                                <p class="text-sm text-gray-600">
                                    金額
                                    <span class="ui-money">
                                        ¥{{ item.amount|number_format(0, '.', ',') }}
                                    </span>
                                </p>
                                <p class="text-sm text-gray-600">
                                    支払者
                                    <span class="font-medium text-gray-900">
                                        {{ item.payer
                                            ? item.payer.member_name
                                            : '不明' }}
                                    </span>
                                </p>
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="ui-label">緯度</label>
                                    <input
                                        name="latitude"
                                        type="number"
                                        step="any"
                                        value="{{
                                        old(
                                            'latitude',
                                            item.location
                                                ? item.location.latitude
                                                : '',
                                        )
                                        }}"
                                        class="ui-input"
                                    />
                                </div>
                                <div>
                                    <label class="ui-label">経度</label>
                                    <input
                                        name="longitude"
                                        type="number"
                                        step="any"
                                        value="{{
                                        old(
                                            'longitude',
                                            item.location
                                                ? item.location.longitude
                                                : '',
                                        )
                                        }}"
                                        class="ui-input"
                                    />
                                </div>
                            </div>

                            <div data-participant-jump-root>
                                <p class="ui-label">対象者（誰の分の支払いか）</p>
                                <div class="mb-2 flex items-stretch gap-2">
                                    <label
                                        class="sr-only"
                                        for="participant-jump-{{ item.id }}"
                                    >
                                        対象者名でジャンプ
                                    </label>
                                    <input
                                        id="participant-jump-{{ item.id }}"
                                        type="search"
                                        enterkeyhint="go"
                                        inputmode="search"
                                        autocomplete="off"
                                        autocorrect="off"
                                        autocapitalize="off"
                                        spellcheck="false"
                                        placeholder="名前の一部で移動"
                                        data-participant-jump-input
                                        class="ui-input"
                                    />
                                    <button
                                        type="button"
                                        data-participant-jump-go
                                        aria-label="名前の一致へスクロール"
                                        class="ui-btn ui-btn-secondary shrink-0"
                                    >
                                        移動
                                    </button>
                                </div>
                                <div
                                    data-participant-jump-scroll
                                    class="ui-scroll max-h-[min(50svh,14rem)] bg-white md:max-h-36"
                                >
                                    {% for member in room.members %}
                                        <label
                                            data-participant-jump-row
                                            data-member-name="{{ member.member_name|e(
                                                'html_attr',
                                            ) }}"
                                            class="ui-choice"
                                        >
                                            <input
                                                type="checkbox"
                                                name="participant_ids[]"
                                                value="{{ member.id }}"
                                                {{ member.id in selectedParticipantIds
                                                    ? 'checked'
                                                    : '' }}
                                                class="ui-check"
                                            />
                                            <span class="text-sm text-gray-900">
                                                {{ member.member_name }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <button
                                    type="submit"
                                    name="_method"
                                    value="PATCH"
                                    class="ui-btn ui-btn-primary"
                                >
                                    更新
                                </button>
                                <button
                                    type="submit"
                                    name="_method"
                                    value="DELETE"
                                    formaction="{{
                                    route(
                                        'rooms.items.delete',
                                        {
                                            room: room.id,
                                            item: item.id,
                                            query_key: room.password_plan,
                                        },
                                    )
                                    }}"
                                    class="ui-btn ui-btn-danger"
                                >
                                    削除
                                </button>
                            </div>
                        </form>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% extends 'layouts.base' %}

{% block title %}
    ルーム作成 - 清算アプリ
{% endblock %}

{% block content %}
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="ui-card w-full max-w-md">
            <h1 class="text-center text-2xl font-semibold tracking-tight text-gray-900">
                "Where Pay" is fair play
            </h1>

            <form
                method="POST"
                action="{{ route('rooms.store') }}"
                class="mt-6 space-y-4"
            >
                <input type="hidden" name="_token" value="{{ csrf_token() }}" />

                <div>
                    <label for="room_name" class="ui-label">
                        グループ名を入力してください
                    </label>
                    <input
                        id="room_name"
                        name="room_name"
                        type="text"
                        placeholder="例: 飲み会グループ"
                        value="{{ old('room_name') }}"
                        class="ui-input"
                        autofocus
                        required
                    />
                    {% if errors.has('room_name') %}
                        <p class="mt-1.5 text-sm text-danger">
                            {{ errors.first('room_name') }}
                        </p>
                    {% endif %}
                </div>

                <button type="submit" class="ui-btn ui-btn-primary w-full">
                    ルームを作成
                </button>
            </form>

            <div class="mt-6 border-t border-gray-200 pt-4">
                <p class="mb-3 text-sm font-medium text-gray-700">主な機能</p>
                <ul class="space-y-2 text-sm text-gray-600">
                    <li class="flex items-center gap-2">
                        <span class="icon-[lucide--check] inline-block h-4 w-4 text-sub-green-ink"></span>
                        メンバー管理と支払い記録
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="icon-[lucide--check] inline-block h-4 w-4 text-sub-green-ink"></span>
                        自動清算計算とおつり計算
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="icon-[lucide--check] inline-block h-4 w-4 text-sub-green-ink"></span>
                        位置情報で思い出を記録
                    </li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
